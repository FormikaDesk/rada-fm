# The menu of the right button on a picture, with "Apri con" open beside it.
Set Width 1584
Set Height 800
Source "docs/tapes/ambiente.tape"
Output "docs/media/.scarto/apri-con.gif"
Type "RADA_DEMO_DEST=$HOME/Documenti rada --icons nerd --images halfblocks --demo openwith ~/projects/demo"
Enter
Sleep 2s
Show
Sleep 2500ms
Screenshot "docs/screenshots/apri-con.png"
Sleep 1s
