# The same on the light Carta theme.
Set Width 1584
Set Height 800
Source "docs/tapes/ambiente-carta.tape"
Output "docs/media/.scarto/apri-con-carta.gif"
Type "RADA_DEMO_DEST=$HOME/Documenti rada --icons nerd --images halfblocks --theme rada-light --demo openwith ~/projects/demo"
Enter
Sleep 2s
Show
Sleep 2500ms
Screenshot "docs/screenshots/apri-con-carta.png"
Sleep 1s
