# The plan of a copy that meets a file with the same name.
Set Width 1584
Set Height 800
Source "docs/tapes/ambiente.tape"
Output "docs/media/.scarto/piano.gif"
Type "RADA_DEMO_DEST=$HOME/Documenti rada --icons nerd --images halfblocks --demo conflict ~/projects/demo"
Enter
Sleep 2s
Show
Sleep 2500ms
Screenshot "docs/screenshots/piano.png"
Sleep 1s
