{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "type": "object",
  "properties": {
    "destination": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "items": {
      "description": "One entry per selected item, for a readable overview.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ItemSummary"
      }
    },
    "kind": {
      "$ref": "#/$defs/OpKind"
    },
    "policy": {
      "$ref": "#/$defs/ConflictPolicy"
    },
    "redo_of": {
      "description": "Set when this plan re-does an operation that was undone.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "renames": {
      "description": "Old name -> new name, for rename previews.",
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "request": {
      "description": "The request this plan answers, kept in the journal so the operation can be\nplanned again later (redo).",
      "anyOf": [
        {
          "$ref": "#/$defs/OpRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reversible": {
      "description": "False for permanent deletion: the journal records it but cannot undo it.",
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      }
    },
    "title": {
      "type": "string"
    },
    "totals": {
      "$ref": "#/$defs/Totals"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "required": [
    "kind",
    "title",
    "steps",
    "totals",
    "warnings",
    "policy",
    "reversible",
    "renames",
    "items"
  ],
  "$defs": {
    "ConflictPolicy": {
      "description": "How to resolve a destination that already exists.",
      "oneOf": [
        {
          "description": "Leave existing items alone, do not copy the clashing source.",
          "type": "string",
          "const": "skip"
        },
        {
          "description": "Copy under a new name (`name (1).ext`).",
          "type": "string",
          "const": "keep_both"
        },
        {
          "description": "Replace; the old item is moved to the trash first so that undo can bring it back.",
          "type": "string",
          "const": "overwrite"
        }
      ]
    },
    "FileKind": {
      "type": "string",
      "enum": [
        "File",
        "Dir",
        "Symlink",
        "Other"
      ]
    },
    "Fingerprint": {
      "description": "Identity of a file at a moment in time, used to detect modifications after the fact.",
      "type": "object",
      "properties": {
        "ctime": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "mtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "size"
      ]
    },
    "ItemAction": {
      "description": "What happens to one top-level item of an operation.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Copy",
            "Move",
            "KeepBoth",
            "Trash",
            "Delete",
            "Rename",
            "Create"
          ]
        },
        {
          "description": "A folder merged into an existing folder of the same name.",
          "type": "string",
          "const": "Merge"
        },
        {
          "description": "Replaces an existing item (the old one goes to the trash first).",
          "type": "string",
          "const": "Overwrite"
        },
        {
          "description": "Left alone: the name already exists, or it is already where it should be.",
          "type": "string",
          "const": "Skip"
        }
      ]
    },
    "ItemSummary": {
      "description": "One selected item and what the plan does with it: the unit the plan window lists.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/ItemAction"
        },
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "path": {
          "description": "The source item (or the new folder for `Create`).",
          "type": "string"
        },
        "symlinks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "target": {
          "description": "Where it ends up, when that differs from where it is.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "path",
        "kind",
        "action",
        "files",
        "dirs",
        "symlinks",
        "bytes"
      ]
    },
    "OpKind": {
      "type": "string",
      "enum": [
        "copy",
        "move",
        "rename",
        "bulk_rename",
        "make_dir",
        "trash",
        "delete",
        "undo"
      ]
    },
    "OpRequest": {
      "description": "A request to do something to files. All paths must be absolute.",
      "oneOf": [
        {
          "description": "Copy items into a folder. Symlinks are copied as symlinks.",
          "type": "object",
          "properties": {
            "conflict": {
              "description": "What to do when a name already exists in the destination.",
              "$ref": "#/$defs/ConflictPolicy",
              "default": "skip"
            },
            "destination": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "copy"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verify": {
              "description": "Re-read and compare every copy.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "sources",
            "destination"
          ]
        },
        {
          "description": "Move items into a folder (a rename on the same filesystem, copy + verify + remove across filesystems).",
          "type": "object",
          "properties": {
            "conflict": {
              "$ref": "#/$defs/ConflictPolicy",
              "default": "skip"
            },
            "destination": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "move"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verify": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "sources",
            "destination"
          ]
        },
        {
          "description": "Rename one item inside its folder.",
          "type": "object",
          "properties": {
            "new_name": {
              "description": "The new file name (a single name, no folder separators).",
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "rename"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "new_name"
          ]
        },
        {
          "description": "Rename several items with a pattern such as `{name}_{n:3}.{ext}` or `s/old/new/`.",
          "type": "object",
          "properties": {
            "counter_start": {
              "description": "First value of `{n}` (default 1).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "counter_step": {
              "description": "Increment of `{n}` (default 1).",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "op": {
              "type": "string",
              "const": "bulk_rename"
            },
            "pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "items",
            "pattern"
          ]
        },
        {
          "description": "Create a folder.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "make_dir"
            },
            "parent": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "parent",
            "name"
          ]
        },
        {
          "description": "Move items to the trash (recoverable).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "trash"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "sources"
          ]
        },
        {
          "description": "Delete items permanently. Cannot be undone; the plan says so and asks for explicit confirmation.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "delete"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "op",
            "sources"
          ]
        },
        {
          "description": "Undo a journal entry (the most recent undoable one when `entry` is omitted).",
          "type": "object",
          "properties": {
            "entry": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "op": {
              "type": "string",
              "const": "undo"
            }
          },
          "additionalProperties": false,
          "required": [
            "op"
          ]
        }
      ]
    },
    "Severity": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Info",
            "Warning"
          ]
        },
        {
          "description": "The plan cannot be executed.",
          "type": "string",
          "const": "Blocking"
        }
      ]
    },
    "Stamp": {
      "description": "A point in time that survives JSON round trips without precision loss.",
      "type": "object",
      "properties": {
        "nanos": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "secs": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "secs",
        "nanos"
      ]
    },
    "Step": {
      "description": "One atomic action. The whole engine (planning, execution, journal, undo) speaks\nonly this vocabulary, which is what makes \"every operation is undoable\" tractable:\neach step knows its own inverse (see [`Step::inverse`]).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "make_dir"
            }
          },
          "required": [
            "step",
            "path"
          ]
        },
        {
          "description": "Apply the final permissions/time of a directory created earlier in the same run\n(after its children exist, so a read-only source dir stays writable meanwhile).",
          "type": "object",
          "properties": {
            "mode": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "mtime": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Stamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "finish_dir"
            }
          },
          "required": [
            "step",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atime": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Stamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dst": {
              "type": "string"
            },
            "mode": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "mtime": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Stamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "remove_source": {
              "description": "Cross-device move: remove the source once the copy is verified.",
              "type": "boolean"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "src": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "copy_file"
            },
            "verify": {
              "description": "Re-read and compare the copy.",
              "type": "boolean"
            }
          },
          "required": [
            "step",
            "src",
            "dst",
            "size",
            "verify",
            "remove_source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dst": {
              "type": "string"
            },
            "remove_source": {
              "type": "boolean"
            },
            "src": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "copy_symlink"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "step",
            "src",
            "dst",
            "target",
            "remove_source"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "rename"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "step",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "trash_item"
            }
          },
          "required": [
            "step",
            "path"
          ]
        },
        {
          "description": "Permanent removal of a file or symlink. With `expect`, refuses to remove a\nfile that changed since it was recorded (used by undo).",
          "type": "object",
          "properties": {
            "expect": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Fingerprint"
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "remove_file"
            }
          },
          "required": [
            "step",
            "path"
          ]
        },
        {
          "description": "Removal of an *empty* directory.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "step": {
              "type": "string",
              "const": "remove_dir"
            }
          },
          "required": [
            "step",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "#/$defs/TrashedItem"
            },
            "step": {
              "type": "string",
              "const": "restore"
            }
          },
          "required": [
            "step",
            "item"
          ]
        }
      ]
    },
    "Totals": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dirs": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "items": {
          "description": "Top-level items the user selected.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "symlinks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "items",
        "files",
        "dirs",
        "symlinks",
        "bytes"
      ]
    },
    "TrashHandle": {
      "description": "Where a trashed item lives, in a backend-specific way.",
      "oneOf": [
        {
          "description": "freedesktop.org Trash specification: the stored file and its `.trashinfo`.",
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "const": "freedesktop"
            },
            "info": {
              "type": "string"
            },
            "stored": {
              "type": "string"
            }
          },
          "required": [
            "backend",
            "stored",
            "info"
          ]
        },
        {
          "description": "Windows Recycle Bin / macOS: an opaque identifier owned by the backend.",
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "const": "opaque"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "backend",
            "id"
          ]
        }
      ]
    },
    "TrashedItem": {
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/TrashHandle"
        },
        "original": {
          "type": "string"
        }
      },
      "required": [
        "original",
        "handle"
      ]
    },
    "Warning": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "examples": {
          "description": "A few representative paths (never all of them: plans can be huge).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "$ref": "#/$defs/WarningKind"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "kind",
        "severity",
        "message",
        "count",
        "examples"
      ]
    },
    "WarningKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Irreversible",
            "InsideItself",
            "NotWritable",
            "LowSpace",
            "Conflict",
            "Overwrite",
            "Unreadable",
            "SpecialFile",
            "BrokenSymlink",
            "Symlink",
            "CircularLink",
            "MountLoop",
            "CrossDevice",
            "SameLocation",
            "HardLinks",
            "InvalidName",
            "Missing",
            "Merge",
            "Other"
          ]
        },
        {
          "description": "An undo step was refused because the item changed since the operation.",
          "type": "string",
          "const": "ModifiedSince"
        },
        {
          "description": "An undo step cannot be carried out (target occupied, source gone, ...).",
          "type": "string",
          "const": "CannotUndo"
        }
      ]
    }
  }
}
