{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpRequest",
  "description": "A request to do something to files. All paths must be absolute.",
  "oneOf": [
    {
      "description": "Copy items into a folder. Symlinks are copied as symlinks.",
      "type": "object",
      "properties": {
        "conflict": {
          "description": "What to do when a name already exists in the destination.",
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "destination": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "copy"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "description": "Re-read and compare every copy.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources",
        "destination"
      ]
    },
    {
      "description": "Move items into a folder (a rename on the same filesystem, copy + verify + remove across filesystems).",
      "type": "object",
      "properties": {
        "conflict": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "destination": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "move"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources",
        "destination"
      ]
    },
    {
      "description": "Rename one item inside its folder.",
      "type": "object",
      "properties": {
        "conflict": {
          "description": "What to do when the new name already exists.",
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "new_name": {
          "description": "The new file name (a single name, no folder separators).",
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "rename"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "path",
        "new_name"
      ]
    },
    {
      "description": "Rename several items with a pattern such as `{name}_{n:3}.{ext}` or `s/old/new/`.",
      "type": "object",
      "properties": {
        "counter_start": {
          "description": "First value of `{n}` (default 1).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "counter_step": {
          "description": "Increment of `{n}` (default 1).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "bulk_rename"
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "items",
        "pattern"
      ]
    },
    {
      "description": "Create a folder.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "make_dir"
        },
        "parent": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "parent",
        "name"
      ]
    },
    {
      "description": "Create an empty file.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "make_file"
        },
        "parent": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "parent",
        "name"
      ]
    },
    {
      "description": "Move items to the trash (recoverable).",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "trash"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources"
      ]
    },
    {
      "description": "Delete items permanently. Cannot be undone; the plan says so and asks for explicit confirmation.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "delete"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources"
      ]
    },
    {
      "description": "Take the contents of an archive out into a folder. With `only`, just those members\n(paths inside the archive); without, everything.",
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "conflict": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "destination": {
          "description": "The folder to extract into (or to make the new folder in).",
          "type": "string"
        },
        "into": {
          "$ref": "#/$defs/ExtractInto",
          "default": {
            "mode": "auto"
          }
        },
        "only": {
          "description": "Members to extract, as paths inside the archive; empty means all.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "extract"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "archive",
        "destination"
      ]
    },
    {
      "description": "Put items into a new archive.",
      "type": "object",
      "properties": {
        "archive": {
          "description": "The archive to create (full path, including its extension).",
          "type": "string"
        },
        "conflict": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "format": {
          "$ref": "#/$defs/ArchiveKind"
        },
        "op": {
          "type": "string",
          "const": "compress"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources",
        "archive",
        "format"
      ]
    },
    {
      "description": "Change the tags of items: add, remove, toggle, clear or replace them.",
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/TagChange"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "set_tags"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "items",
        "change"
      ]
    },
    {
      "description": "Undo a journal entry (the most recent undoable one when `entry` is omitted).",
      "type": "object",
      "properties": {
        "entry": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "op": {
          "type": "string",
          "const": "undo"
        }
      },
      "additionalProperties": false,
      "required": [
        "op"
      ]
    },
    {
      "description": "Several requests as one operation, among them new files made by other programs.",
      "type": "object",
      "properties": {
        "failure": {
          "description": "What becomes of what was made when a step fails.",
          "$ref": "#/$defs/FailurePolicy",
          "default": "keep"
        },
        "notes": {
          "description": "Lines the recipe wants shown with the plan.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "recipe"
        },
        "recipe": {
          "description": "The name of the recipe that asks.",
          "type": "string"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubRequest"
          }
        },
        "title": {
          "description": "The title of the plan; without one it is made from the requests.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "recipe",
        "requests"
      ]
    }
  ],
  "$defs": {
    "ArchiveKind": {
      "description": "Which formats a user may ask `rada` to create.",
      "type": "string",
      "enum": [
        "zip",
        "tar_gz",
        "tar_zst",
        "tar_xz"
      ]
    },
    "Arg": {
      "description": "One argument of a program. Paths are filled in when the step runs; each is one argument,\nwhatever characters it holds.",
      "oneOf": [
        {
          "description": "Given as it is.",
          "type": "object",
          "properties": {
            "lit": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "lit"
          ]
        },
        {
          "description": "The path of the input with this number, from 0.",
          "type": "object",
          "properties": {
            "input": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "input"
          ]
        },
        {
          "description": "Every input, one argument each.",
          "type": "string",
          "const": "inputs"
        },
        {
          "description": "What the program before this one in the chain wrote.",
          "type": "string",
          "const": "prev"
        },
        {
          "description": "The file this program is to write.",
          "type": "string",
          "const": "out"
        },
        {
          "description": "The folder the programs work in, for one that names its output by itself.",
          "type": "string",
          "const": "out_dir"
        },
        {
          "description": "LibreOffice's option for a profile of its own inside the work folder, so that it\nneither waits for nor changes the person's own.",
          "type": "string",
          "const": "profile_url"
        }
      ]
    },
    "ChecksumAlgo": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "Collect": {
      "description": "How the file the last program wrote is found.",
      "oneOf": [
        {
          "description": "It is where [`Arg::Out`] said.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "It is the only file with this extension in the work folder ([`Arg::OutDir`]).",
          "type": "object",
          "properties": {
            "single": {
              "type": "object",
              "properties": {
                "ext": {
                  "type": "string"
                }
              },
              "required": [
                "ext"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "single"
          ]
        }
      ]
    },
    "ConflictPolicy": {
      "description": "How to resolve a destination that already exists.",
      "oneOf": [
        {
          "description": "Leave existing items alone, do not copy the clashing source.",
          "type": "string",
          "const": "skip"
        },
        {
          "description": "Copy under a new name (`name (1).ext`).",
          "type": "string",
          "const": "keep_both"
        },
        {
          "description": "Replace; the old item is moved to the trash first so that undo can bring it back.",
          "type": "string",
          "const": "overwrite"
        }
      ]
    },
    "ExtractInto": {
      "description": "Where the members of an archive land.",
      "oneOf": [
        {
          "description": "Straight into the destination folder.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "here"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Into a folder named after the archive (without its extensions) — unless the archive\nalready has a single folder at its top, which then is the folder.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "auto"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Into a folder with this name.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "folder"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "name"
          ]
        }
      ]
    },
    "FailurePolicy": {
      "description": "What becomes of the steps that worked when another of the same plan fails.",
      "oneOf": [
        {
          "description": "What was made stays, and can be undone.",
          "type": "string",
          "const": "keep"
        },
        {
          "description": "What was made is taken back.",
          "type": "string",
          "const": "rollback"
        }
      ]
    },
    "ProduceSpec": {
      "description": "One new file to make.",
      "type": "object",
      "properties": {
        "inputs": {
          "description": "The files that are read. They are never changed.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "description": "The file to write (a whole path). If the name is taken when the file is ready, it\ngets the next free one (`name (1).ext`): nothing is ever replaced.",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerSpec"
        },
        "size_hint": {
          "description": "About how many bytes the file will be, to check the free space.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "inputs",
        "output",
        "producer"
      ]
    },
    "ProducerSpec": {
      "description": "What is to write the file.",
      "oneOf": [
        {
          "description": "One program, or several run one after the other.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "program"
            },
            "chain": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProgramCall"
              }
            },
            "collect": {
              "$ref": "#/$defs/Collect",
              "default": "exact"
            },
            "ok_exit": {
              "description": "Exit codes that mean success (default 0).",
              "type": "array",
              "default": [
                0
              ],
              "items": {
                "type": "integer",
                "format": "int32"
              }
            },
            "timeout_secs": {
              "description": "Seconds each program is given (default 600).",
              "type": "integer",
              "format": "uint64",
              "default": 600,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "by",
            "chain"
          ]
        },
        {
          "description": "The checksum of the one input, as `sha256sum` writes it.",
          "type": "object",
          "properties": {
            "algo": {
              "$ref": "#/$defs/ChecksumAlgo"
            },
            "by": {
              "type": "string",
              "const": "checksum"
            }
          },
          "additionalProperties": false,
          "required": [
            "by",
            "algo"
          ]
        }
      ]
    },
    "ProgramCall": {
      "description": "A program by the name recipes call it (`qpdf`, `gs`, `magick`, `ffmpeg`, `soffice`…, or\none the configuration names), and its arguments.",
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Arg"
          }
        },
        "program": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "program",
        "args"
      ]
    },
    "SubRequest": {
      "description": "One of the requests of a recipe.",
      "oneOf": [
        {
          "description": "Any request but an undo or another recipe.",
          "type": "object",
          "properties": {
            "op": {
              "$ref": "#"
            }
          },
          "additionalProperties": false,
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "properties": {
            "produce": {
              "$ref": "#/$defs/ProduceSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "produce"
          ]
        }
      ]
    },
    "Tag": {
      "description": "One tag: a name, and the colour it is drawn in when it has one.",
      "type": "object",
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/TagColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "TagChange": {
      "description": "What to do to the tags of the items.",
      "oneOf": [
        {
          "description": "Give every item this tag (those that have it are left alone).",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "add"
            },
            "tag": {
              "$ref": "#/$defs/Tag"
            }
          },
          "required": [
            "how",
            "tag"
          ]
        },
        {
          "description": "Take the tag called `name` off every item.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "remove"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "how",
            "name"
          ]
        },
        {
          "description": "Take the tag off if every item has it, give it to every item otherwise: what clicking\na colour in the menu does.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "toggle"
            },
            "tag": {
              "$ref": "#/$defs/Tag"
            }
          },
          "required": [
            "how",
            "tag"
          ]
        },
        {
          "description": "Remove all tags.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "clear"
            }
          },
          "required": [
            "how"
          ]
        },
        {
          "description": "Replace the tags of every item with exactly these.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "set"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Tag"
              }
            }
          },
          "required": [
            "how",
            "tags"
          ]
        }
      ]
    },
    "TagColor": {
      "description": "The Finder's colours, as the menu lists them.",
      "type": "string",
      "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple",
        "gray"
      ]
    }
  }
}
