{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpRequest",
  "description": "A request to do something to files. All paths must be absolute.",
  "oneOf": [
    {
      "description": "Copy items into a folder. Symlinks are copied as symlinks.",
      "type": "object",
      "properties": {
        "conflict": {
          "description": "What to do when a name already exists in the destination.",
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "destination": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "copy"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "description": "Re-read and compare every copy.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources",
        "destination"
      ]
    },
    {
      "description": "Move items into a folder (a rename on the same filesystem, copy + verify + remove across filesystems).",
      "type": "object",
      "properties": {
        "conflict": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "destination": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "move"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources",
        "destination"
      ]
    },
    {
      "description": "Rename one item inside its folder.",
      "type": "object",
      "properties": {
        "conflict": {
          "description": "What to do when the new name already exists.",
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "new_name": {
          "description": "The new file name (a single name, no folder separators).",
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "rename"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "path",
        "new_name"
      ]
    },
    {
      "description": "Rename several items with a pattern such as `{name}_{n:3}.{ext}` or `s/old/new/`.",
      "type": "object",
      "properties": {
        "counter_start": {
          "description": "First value of `{n}` (default 1).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "counter_step": {
          "description": "Increment of `{n}` (default 1).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "bulk_rename"
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "items",
        "pattern"
      ]
    },
    {
      "description": "Create a folder.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "make_dir"
        },
        "parent": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "parent",
        "name"
      ]
    },
    {
      "description": "Create an empty file.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "const": "make_file"
        },
        "parent": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "parent",
        "name"
      ]
    },
    {
      "description": "Move items to the trash (recoverable).",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "trash"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources"
      ]
    },
    {
      "description": "Delete items permanently. Cannot be undone; the plan says so and asks for explicit confirmation.",
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "delete"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources"
      ]
    },
    {
      "description": "Take the contents of an archive out into a folder. With `only`, just those members\n(paths inside the archive); without, everything.",
      "type": "object",
      "properties": {
        "archive": {
          "type": "string"
        },
        "conflict": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "destination": {
          "description": "The folder to extract into (or to make the new folder in).",
          "type": "string"
        },
        "into": {
          "$ref": "#/$defs/ExtractInto",
          "default": {
            "mode": "auto"
          }
        },
        "only": {
          "description": "Members to extract, as paths inside the archive; empty means all.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "extract"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "archive",
        "destination"
      ]
    },
    {
      "description": "Put items into a new archive.",
      "type": "object",
      "properties": {
        "archive": {
          "description": "The archive to create (full path, including its extension).",
          "type": "string"
        },
        "conflict": {
          "$ref": "#/$defs/ConflictPolicy",
          "default": "skip"
        },
        "format": {
          "$ref": "#/$defs/ArchiveKind"
        },
        "op": {
          "type": "string",
          "const": "compress"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "sources",
        "archive",
        "format"
      ]
    },
    {
      "description": "Change the tags of items: add, remove, toggle, clear or replace them.",
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/TagChange"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "op": {
          "type": "string",
          "const": "set_tags"
        }
      },
      "additionalProperties": false,
      "required": [
        "op",
        "items",
        "change"
      ]
    },
    {
      "description": "Undo a journal entry (the most recent undoable one when `entry` is omitted).",
      "type": "object",
      "properties": {
        "entry": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "op": {
          "type": "string",
          "const": "undo"
        }
      },
      "additionalProperties": false,
      "required": [
        "op"
      ]
    }
  ],
  "$defs": {
    "ArchiveKind": {
      "description": "Which formats a user may ask `rada` to create.",
      "type": "string",
      "enum": [
        "zip",
        "tar_gz",
        "tar_zst",
        "tar_xz"
      ]
    },
    "ConflictPolicy": {
      "description": "How to resolve a destination that already exists.",
      "oneOf": [
        {
          "description": "Leave existing items alone, do not copy the clashing source.",
          "type": "string",
          "const": "skip"
        },
        {
          "description": "Copy under a new name (`name (1).ext`).",
          "type": "string",
          "const": "keep_both"
        },
        {
          "description": "Replace; the old item is moved to the trash first so that undo can bring it back.",
          "type": "string",
          "const": "overwrite"
        }
      ]
    },
    "ExtractInto": {
      "description": "Where the members of an archive land.",
      "oneOf": [
        {
          "description": "Straight into the destination folder.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "here"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Into a folder named after the archive (without its extensions) — unless the archive\nalready has a single folder at its top, which then is the folder.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "auto"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "description": "Into a folder with this name.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "folder"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "mode",
            "name"
          ]
        }
      ]
    },
    "Tag": {
      "description": "One tag: a name, and the colour it is drawn in when it has one.",
      "type": "object",
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/TagColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "TagChange": {
      "description": "What to do to the tags of the items.",
      "oneOf": [
        {
          "description": "Give every item this tag (those that have it are left alone).",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "add"
            },
            "tag": {
              "$ref": "#/$defs/Tag"
            }
          },
          "required": [
            "how",
            "tag"
          ]
        },
        {
          "description": "Take the tag called `name` off every item.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "remove"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "how",
            "name"
          ]
        },
        {
          "description": "Take the tag off if every item has it, give it to every item otherwise: what clicking\na colour in the menu does.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "toggle"
            },
            "tag": {
              "$ref": "#/$defs/Tag"
            }
          },
          "required": [
            "how",
            "tag"
          ]
        },
        {
          "description": "Remove all tags.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "clear"
            }
          },
          "required": [
            "how"
          ]
        },
        {
          "description": "Replace the tags of every item with exactly these.",
          "type": "object",
          "properties": {
            "how": {
              "type": "string",
              "const": "set"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Tag"
              }
            }
          },
          "required": [
            "how",
            "tags"
          ]
        }
      ]
    },
    "TagColor": {
      "description": "The Finder's colours, as the menu lists them.",
      "type": "string",
      "enum": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple",
        "gray"
      ]
    }
  }
}
