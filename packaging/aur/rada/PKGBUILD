# Maintainer: Alessandro Formica <alessandroformica6@gmail.com>
#
# rada, built from the tag of a release. `scripts/aur-bump <tag>` moves pkgver, _tag, the
# checksum and .SRCINFO to another tag; nothing else needs touching for a new release.
# Rust packaging follows https://wiki.archlinux.org/title/Rust_package_guidelines.

pkgname=rada
# The tag as GitHub has it. pkgver is the same without the hyphen and the dot of the suffix
# (a pkgver cannot hold a hyphen): v0.6.0-rc.16 -> 0.6.0rc16. `vercmp 0.6.0rc16 0.6.0` is -1:
# pacman orders the release candidate before 0.6.0 (with an underscore, 0.6.0_rc16, it would
# come after it) and rc9 before rc10.
_tag=v0.6.0-rc.16
pkgver=0.6.0rc16
pkgrel=1
pkgdesc='A terminal file manager where every destructive action is planned first and can be undone'
arch=('x86_64' 'aarch64')
url='https://github.com/FormikaDesk/rada-fm'
license=('MIT')
# The binary links glibc and libgcc_s only (zstd is bundled and linked in).
depends=('glibc' 'gcc-libs')
makedepends=('cargo')
optdepends=(
  'xdg-utils: open files and folders with the default program'
  'poppler: previews of PDF files'
  'udisks2: eject removable disks'
  '7zip: read RAR archives (unrar does it too)'
  'ttf-jetbrains-mono-nerd: the icons of the file types'
)
# Rust with C code in the build (zstd): link-time optimisation is rada's own (see Cargo.toml);
# the binary is stripped by the build itself, so there is nothing for a debug package.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$_tag.tar.gz")
sha256sums=('6aff1db5b73547c3170b9bafa86f53236b54eac8d78cd456e545a3f05dcad718')

_srcdir() {
  # GitHub names the folder of a tag archive after the repository and the tag without its "v".
  echo "rada-fm-${_tag#v}"
}

prepare() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  CARGO_TARGET_DIR=target cargo build --frozen --release -p rada
}

check() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  # The unit tests of the libraries: a few minutes of build, a few seconds to run. The tests
  # that start programs and touch disks are the project's CI, which runs the whole suite on
  # Linux, macOS and Windows for every push. Then that the binary is the one of the tag.
  CARGO_TARGET_DIR=target cargo test --frozen --release --workspace --lib
  test "$(target/release/rada --version)" = "rada ${_tag#v}"
}

package() {
  cd "$(_srcdir)"
  install -Dm755 target/release/rada "$pkgdir/usr/bin/rada"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/linux/rada.desktop "$pkgdir/usr/share/applications/rada.desktop"
  install -Dm644 packaging/linux/rada.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/rada.svg"
  local size
  for size in 48 128 256; do
    install -Dm644 "packaging/linux/rada-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/rada.png"
  done
}
